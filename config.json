{
  "model": "roPac",
  "base_model": "qwen3.5:latest",
  "embed_model": "nomic-embed-text",
  "embeddings_enabled": true,
  "ollama_base_url": "http://localhost:11434/v1",
  "openai_base_url": "https://api.openai.com/v1",
