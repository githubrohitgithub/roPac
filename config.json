  "rag_min_memory_keyword_score": 0.08,
  "chat_attachments_enabled": true,
  "chat_attachment_max_chars": 60000,
  "chat_session_max_files": 30,
  "chat_model_context_tokens": 32768,
  "chat_context_reserved_tokens": 4096,
